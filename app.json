{
  "expo": {
    "name": "Rollover",
    "slug": "rollover",
    "scheme": "rollover",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.rollover.clock",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "app.rollover.clock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#000000"
        }
      ],
      ["expo-router", { "sitemap": false }],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": ["en", "de", "es", "fr", "hi", "id", "it", "ja", "ko", "nl", "pl", "pt", "ru", "tr", "uk", "zh-Hans", "zh-Hant"]
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv/android-banner.png",
          "appleTVImages": {
            "iconLayers": { "front": "./assets/tv/icon-front.png", "back": "./assets/tv/icon-back.png" },
            "iconSmallLayers": { "front": "./assets/tv/icon-small-front.png", "back": "./assets/tv/icon-small-back.png" },
            "iconSmall2xLayers": { "front": "./assets/tv/icon-small@2x-front.png", "back": "./assets/tv/icon-small@2x-back.png" },
            "topShelf": "./assets/tv/top-shelf.png",
            "topShelf2x": "./assets/tv/top-shelf@2x.png",
            "topShelfWide": "./assets/tv/top-shelf-wide.png",
            "topShelfWide2x": "./assets/tv/top-shelf-wide@2x.png"
          }
        }
      ]
    ],
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Rollover",
      "description": "A clock that rolls over midnight, again and again.",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "experiments": {
      "baseUrl": "/rollover"
    }
  }
}
