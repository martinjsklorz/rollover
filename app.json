{
  "expo": {
    "name": "Rollover",
    "slug": "rollover",
    "scheme": "rollover",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.rollover.clock",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "app.rollover.clock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#000000"
        }
      ],
      ["expo-router", { "sitemap": false }]
    ],
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Rollover",
      "description": "A clock that rolls over midnight, again and again.",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "experiments": {
      "baseUrl": "/rollover"
    }
  }
}
